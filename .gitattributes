# De hashlijsten van de vectorsuites zijn genomen over de bytes met CRLF naar LF. Met LF in de werkmap geeft ook een gewone
# sha256sum -c op Windows dezelfde uitkomst als ons eigen commando.
vectors/**/*.json text eol=lf
vectors/*/SHA256SUMS text eol=lf
# The refusal-row files are compared by hash, so they keep LF in a checkout on Windows with core.autocrlf=true.
interop/refusal-row/* text eol=lf
