          "errorMessage": "authorization already used",
          "transaction": "",
          "network": "eip155:84532"
        },
        "chain": {
          "receipt": "deep",
          "transfer": {
            "to": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
            "amount": "10000"
          }
        },
        "retry": {
          "sameAuthorization": true,
          "hashFromNonceLookup": "0x2222222222222222222222222222222222222222222222222222222222222222"
        }
      },
      "expected": {
        "outcome": "DELIVER",
        "secondSettle": false
      }
