{
  "schema_version": "0.2.0",
  "protocol": "x402",
  "network": "eip155:84532",
  "credit": "Cases and field behaviour: mitaka7210 / kristo-intelligence-6 (MIT), including the reverted case and the hash of another payment. Format, wrong twins and runner: github.com/holistis. Draft 2, nothing published, 22 Nov 2026.",
  "supersedes": "Draft 1, sha256 of vectors.json starts with fd234a289755, kept unchanged in v0-bevroren/.",
  "provenance": [
    "x402 v2 specification section 9 (settlement_pending is non-terminal, hash and network must be present)",
    "@x402/core 2.29.0 settleWithPendingRetry (one retry, same payload)",
    "mitaka7210 Slack account of the 425 hold and adoption by nonce",
    "mitaka7210 Slack message of 22 Nov 2026: a hash that settled another payment, and a reverted transaction as a terminal refusal"
  ],
  "vectors": [
    {
      "id": "x402-settlement-pending-boolean-lies",
      "basis": [
        "spec",
        "rec"
      ],
      "encodes": "success false does not mean the payment failed: a pending settlement with a confirmed matching transfer is delivered.",
      "input": {
        "quote": {
          "payTo": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
          "price": "10000"
        },
        "response": {
          "success": false,
          "errorReason": "settlement_pending",
          "errorMessage": "Receipt not found before timeout",
          "transaction": "0x1111111111111111111111111111111111111111111111111111111111111111",
          "network": "eip155:84532"
        },
        "chain": {
          "receipt": "deep",
          "transfer": {
            "to": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
            "amount": "10000",
            "nonce": "0xa1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
          }
        },
        "retry": null,
        "payment": {
          "nonce": "0xa1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        }
      },
      "expected": {
        "outcome": "DELIVER",
        "secondSettle": false
      }
    },
