    {
      "id": "x402-settlement-pending-pending-without-hash-open",
      "basis": [
        "spec"
      ],
      "encodes": "Pending without the broadcast hash breaks the spec, which says the hash must be present. What a seller does then is not settled: x402 pull request 3437 would treat it as unresolved and not challenge again, while mitaka7210 refuses. Recorded as OPEN, asserted by nobody.",
      "input": {
        "quote": {
          "payTo": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
          "price": "10000"
        },
        "response": {
          "success": false,
          "errorReason": "settlement_pending",
          "errorMessage": "Receipt not found before timeout",
          "transaction": "",
          "network": "eip155:84532"
        },
        "chain": {
          "receipt": "absent",
          "transfer": null
        },
        "retry": null,
        "payment": {
          "nonce": "0xa1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        }
      },
      "expected": {
        "outcome": "OPEN",
        "secondSettle": false
      },
      "asserted": false,
      "disputed": [
        "hold: do not challenge again (x402 pull request 3437, not merged)",
        "refuse: no hash, nothing to reconcile (mitaka7210, kristo-intelligence-6)"
      ]
    },
